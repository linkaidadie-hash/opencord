# =====================================================
# OpenCord / 开弦 — Environment Variables
# 复制本文件为 .env 并填入实际值
# =====================================================

# -------- General --------
NODE_ENV=development
OPENCORD_VERSION=0.1.0
OPENCORD_INSTANCE_NAME="My OpenCord Community"
OPENCORD_BASE_URL=http://localhost:3000

# -------- Database --------
POSTGRES_USER=opencord
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=opencord
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opencord:change_me_in_production@postgres:5432/opencord

# -------- Redis --------
REDIS_URL=redis://redis:6379/0

# -------- Auth --------
# JWT 签名密钥（生产环境务必用 openssl rand -hex 32 生成）
JWT_SECRET=change_me_to_a_64_char_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# -------- Storage --------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# -------- AI Providers --------
# 至少配置一个。Provider 切换在后台管理界面进行。
# 格式：API_KEY / BASE_URL / MODEL
# Provider 类型：openai-compatible | MiniMax | deepseek | ollama

# 1. OpenAI-compatible（OpenAI 官方 / OpenRouter / 硅基流动 / 任何兼容接口）
AI_DEFAULT_PROVIDER=openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 2. MiniMax（M2M 协议，目前 MiniMax 是闭源的，M2M 协议可走国内各家）
MiniMax_API_KEY=
MiniMax_BASE_URL=https://api.MiniMax.chat/v1
MiniMax_MODEL=MiniMax-abab6.5s-chat

# 3. DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 4. Ollama（本地）
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1

# -------- Feature Flags --------
FEATURE_AI_SUMMARY=true
FEATURE_API_TOKENS=true
FEATURE_DATA_EXPORT=true
FEATURE_REGISTRATION=true  # false 时只能管理员邀请

# -------- Admin (initial) --------
# 首次启动时创建的初始管理员账号
INITIAL_ADMIN_EMAIL=admin@opencord.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_now

# -------- Logging --------
LOG_LEVEL=INFO
LOG_FORMAT=json
